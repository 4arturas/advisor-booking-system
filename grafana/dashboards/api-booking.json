{
  "title": "API Booking",
  "uid": "api-booking",
  "version": 2,
  "panels": [
    {
      "title": "Booking Requests Rate",
      "type": "timeseries",
      "datasource": "Prometheus",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
      "targets": [
        {
          "expr": "rate(nr_booking_requests_total[5m])",
          "legendFormat": "Requests"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "req/s",
          "custom": { "showPoints": "never" },
          "color": { "mode": "palette-classic" }
        }
      }
    },
    {
      "title": "Booking Success vs Failures",
      "type": "timeseries",
      "datasource": "Prometheus",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
      "targets": [
        {
          "expr": "rate(nr_booking_success_total[5m])",
          "legendFormat": "Success"
        },
        {
          "expr": "rate(nr_booking_failure_total[5m])",
          "legendFormat": "Failures"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "req/s",
          "custom": { "showPoints": "never" },
          "color": { "mode": "palette-classic" }
        }
      }
    }
  ],
  "schemaVersion": 39,
  "time": { "from": "now-1h", "to": "now" },
  "timezone": "browser",
  "editable": true
}
